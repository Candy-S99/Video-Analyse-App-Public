# Optional: eigener Google-Gemini-API-Schlüssel.
# Alternativ kann der Schlüssel nach dem Start in Einstellungen gesetzt werden.
GEMINI_API_KEY=

# Optional: leer lassen, damit der App-Standard verwendet wird.
GEMINI_MODEL=

# Optional: Analyse- und Transkriptionsverhalten.
SEGMENT_LENGTH=30
EXTRACT_TRANSCRIPT=true

# Optional: Host-Port der Weboberfläche.
APP_PORT=3006
